# Copy this file to .env. Never commit .env or share its secrets.
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=northstar_soccer_team

# Invitation delivery (configure the provider for the selected invite method).
APP_ORIGIN=http://localhost:5173
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM_EMAIL=North Star <invites@your-verified-domain.com>
TWILIO_ACCOUNT_SID=AC_replace_with_your_account_sid
TWILIO_AUTH_TOKEN=replace_with_your_auth_token
TWILIO_FROM_NUMBER=+15551234567
# Alternatively, use a Twilio Messaging Service instead of TWILIO_FROM_NUMBER.
# TWILIO_MESSAGING_SERVICE_SID=MG_replace_with_your_messaging_service_sid

# Stripe Checkout for donations (use a test-mode key until going live).
STRIPE_SECRET_KEY=sk_test_replace_with_your_key
CHECKOUT_ORIGIN=http://localhost:5173
PORT=4242
