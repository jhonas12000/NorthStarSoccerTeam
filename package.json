{
  "name": "northstarsoccerteam",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "server": "node backend/express.js",
    "start": "node backend/express.js",
    "build": "tsc -b && vite build --config frontend/vite.config.ts",
    "lint": "oxlint",
    "test": "vitest run --config frontend/vitest.config.ts",
